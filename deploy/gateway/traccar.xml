<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<!--
  Ingestion gateway configuration (Traccar).

  Role in this platform: hold device connections, decode the 200+ GPS protocols, ACK devices,
  and forward every decoded position and event to Kafka. Nothing downstream reads Traccar's
  own database or API; the ingest-bridge service consumes the Kafka topics below.

  Every supported protocol listens on its own default port (5001-5268). Devices are configured
  with this host and the port of their protocol, e.g. GT06 = 5023, Teltonika = 5027, H02 = 5013,
  OsmAnd = 5055. Full list: https://www.traccar.org/devices/

  Reference: https://www.traccar.org/configuration-file/
-->
<properties>

    <!-- Gateway-local state only (device sessions, auto-registered devices). Phase 1: embedded H2. -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- Accept any device that connects. Access control is enforced downstream by the
         ingest-bridge allow-list (unregistered devices are reported on device.unknown). -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Forward every decoded position to Kafka (producer uses acks=all). -->
    <entry key='forward.type'>kafka</entry>
    <entry key='forward.url'>kafka:9092</entry>
    <entry key='forward.topic'>traccar.positions</entry>

    <!-- Forward every generated event (deviceOnline/Offline, ignitionOn/Off, alarm, ...) to Kafka. -->
    <entry key='event.forward.type'>kafka</entry>
    <entry key='event.forward.url'>kafka:9092</entry>
    <entry key='event.forward.topic'>traccar.events</entry>

    <!-- Status: mark devices offline 5 minutes after their last message. -->
    <entry key='status.timeout'>300</entry>

    <!-- Admin web UI / API (8082) is only used for gateway troubleshooting. -->
    <entry key='web.port'>8082</entry>

    <entry key='logger.console'>true</entry>
    <entry key='logger.level'>info</entry>

</properties>
